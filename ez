#!/usr/bin/env sh
# Short CLI for ez-engine: `ez new project-name [--workspace DIR]`.
set -eu

ENGINE_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

usage() {
    cat <<'EOF'
Usage:
  ez new <project-name> [--workspace DIR]   Scaffold a new game project
  ez help                                   Show this message

Creates projects with `zig build new` (default workspace: projects/ beside the engine checkout).
EOF
}

if [ $# -eq 0 ]; then
    usage >&2
    exit 1
fi

cmd="$1"
shift

case "$cmd" in
    new)
        if [ $# -eq 0 ]; then
            echo "ez: 'new' needs a project name" >&2
            usage >&2
            exit 1
        fi
        name="$1"
        shift
        workspace=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --workspace)
                    [ $# -ge 2 ] || { echo "ez: '--workspace' needs a directory" >&2; exit 1; }
                    workspace="$2"
                    shift 2
                    ;;
                -h|--help)
                    usage
                    exit 0
                    ;;
                *)
                    echo "ez: unknown argument: $1" >&2
                    usage >&2
                    exit 1
                    ;;
            esac
        done
        if [ -z "$workspace" ]; then
            cd "$ENGINE_ROOT"
            exec zig build new -Dname="$name"
        else
            cd "$ENGINE_ROOT"
            exec zig build new -Dname="$name" -Dworkspace="$workspace"
        fi
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "ez: unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
